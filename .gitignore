# ============================================================
# .gitignore for a NetBeans (Ant) web project
# Place it in the folder that contains build.xml
# ============================================================

# ---------- Build output (regenerated by Ant) ----------
/build/
/dist/
/nbbuild/
/nbdist/
*.class
*.war
*.ear

# ---------- NetBeans user-specific config ----------
# private/ holds local paths, open files, server settings
/nbproject/private/
/nbproject/Makefile-*.mk
/nbproject/Package-*.bash

# ---------- Tomcat / server leftovers ----------
*.log
/web/WEB-INF/classes/

# ---------- OS junk ----------
.DS_Store
Thumbs.db
desktop.ini
